{
  "name": "dsh-pilot",
  "version": "0.2.1",
  "description": "Give your DSH agent hands: drive a real browser (Edge/Chrome over CDP) from the chat, with a live draggable cockpit panel in the Web GUI. Zero runtime dependencies, no API key, one command install.",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "browser",
    "cdp",
    "agent",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guo6x/dsh-pilot.git"
  }
}
